---
import { Image } from 'astro:assets';
import RegisterButton from './RegisterButton.astro';
import wordmark from '../assets/logos/2026-wordmark.png';

const nav = [
  { href: '/programme', label: 'Programme' },
  { href: '/speakers', label: 'Speakers' },
  { href: '/editions', label: 'Past editions' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-line/80 bg-paper/85 backdrop-blur-md supports-[backdrop-filter]:bg-paper/75">
  <div class="container-site flex h-16 items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label="AI Governance Forum, home">
      <Image src={wordmark} alt="AI GF’26" height={44} class="wordmark-white h-[22px] w-auto" />
    </a>
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1 text-sm font-medium">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['rounded-full px-3.5 py-2 transition hover:bg-wash hover:text-brand-blue', isCurrent(item.href) ? 'text-brand-blue' : 'text-ink/80']}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="hidden lg:block"><RegisterButton size="sm" /></div>
    <details class="group lg:hidden">
      <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-line px-4 py-2 text-sm font-medium [&::-webkit-details-marker]:hidden">
        <span class="group-open:hidden">Menu</span><span class="hidden group-open:inline">Close</span>
        <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.75">
          <path class="group-open:hidden" d="M2 5h12M2 11h12" /><path class="hidden group-open:inline" d="M4 4l8 8M12 4l-8 8" />
        </svg>
      </summary>
      <nav aria-label="Main" class="absolute inset-x-0 top-16 border-b border-line bg-paper shadow-[0_24px_48px_-24px_rgb(0_0_0/0.6)]">
        <ul class="container-site divide-y divide-line py-2 text-lg font-medium">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class:list={['flex items-center justify-between py-3.5', isCurrent(item.href) && 'text-brand-blue']} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                  <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4 text-muted" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M6 3l5 5-5 5" /></svg>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="container-site pt-2 pb-6"><RegisterButton size="lg" /></div>
      </nav>
    </details>
  </div>
</header>
