---
import { Image } from 'astro:assets';
import { getEntries } from 'astro:content';
import { initials, type Edition } from '../lib/data';

interface Props {
  edition: Edition;
}
const { edition } = Astro.props;
// Role and organisation as they were that year, from the edition's speaker list.
const atTheTime = new Map(edition.data.speakers.map((a) => [a.speaker.id, a]));
const items = await Promise.all(
  edition.data.schedule.map(async (item) => ({ ...item, people: (await getEntries(item.speakers)).filter((p) => p && !p.data.draft).map((p) => p!) })),
);
const days = [...new Set(items.map((i) => i.day ?? ''))];
const isBreak = (title: string) => /\b(break|lunch|pause|apéro|apero)\b/i.test(title);
---

{
  items.length === 0 ? (
    <div class="rounded-2xl border border-dashed border-line px-6 py-12 text-center">
      <p class="text-lg font-medium">Programme coming soon</p>
      <p class="mt-1 text-muted">The schedule will appear here once it is published.</p>
    </div>
  ) : (
    days.map((day) => (
      <section class="mt-12 first:mt-0">
        {day && <h3 class="eyebrow mb-4 text-muted">{day}</h3>}
        <ol class="border-t border-line">
          {items
            .filter((i) => (i.day ?? '') === day)
            .map((item) => {
              // Rows without a title are talks inside the session above them.
              const sub = !item.title;
              const pause = item.title && isBreak(item.title) && item.people.length === 0;
              return (
                <li class:list={['grid gap-x-8 gap-y-2 border-b border-line py-5 sm:grid-cols-[8.5rem_1fr]', pause && 'bg-wash/60']}>
                  <p class:list={['pt-0.5 text-sm tabular-nums text-muted', sub && 'sm:pl-4']}>{item.time}</p>
                  <div class:list={[sub && 'border-l-2 border-line pl-4 sm:pl-5']}>
                    {item.title && <p class:list={['leading-snug text-balance', pause ? 'text-muted' : 'text-lg font-semibold']}>{item.title}</p>}
                    {item.people.length > 0 && (
                      <ul class:list={['flex flex-col gap-3', item.title && 'mt-3']}>
                        {item.people.map((p) => {
                          const a = atTheTime.get(p.id);
                          const role = [a?.roleAtTheTime ?? p.data.title, a?.organisationAtTheTime ?? p.data.organisation].filter(Boolean).join(', ');
                          return (
                            <li>
                              <a href={`/speakers/${p.id}`} class="group flex items-center gap-3">
                                <span class="size-10 shrink-0 overflow-hidden rounded-full bg-wash ring-1 ring-line">
                                  {p.data.photo ? (
                                    <Image src={p.data.photo} alt="" width={80} height={80} class="h-full w-full object-cover object-[50%_25%] grayscale transition group-hover:grayscale-0" />
                                  ) : (
                                    <span class="text-brand-gradient flex h-full w-full items-center justify-center text-xs font-semibold" aria-hidden="true">{initials(p.data.name)}</span>
                                  )}
                                </span>
                                <span class="min-w-0">
                                  <span class="block font-semibold leading-snug transition group-hover:text-brand-blue">{p.data.name}</span>
                                  {role && <span class="block text-sm leading-snug text-muted">{role}</span>}
                                </span>
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    )}
                    {item.description && <p class="mt-2 max-w-prose-70 text-sm leading-relaxed whitespace-pre-line text-muted">{item.description}</p>}
                    {item.links.length > 0 && (
                      <p class="mt-3 flex flex-wrap gap-2">
                        {item.links.map((l) => (
                          <a href={l.url} class="inline-flex h-8 items-center gap-1.5 rounded-full border border-line px-3 text-sm font-medium transition hover:border-brand-blue hover:text-brand-blue">
                            <svg aria-hidden="true" viewBox="0 0 16 16" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.75">
                              <path d={/\.(pdf|pptx?|docx?)$/i.test(l.url) ? 'M8 2v8M4.5 6.5 8 10l3.5-3.5M3 13h10' : 'M5 11l6-6M6 5h5v5'} />
                            </svg>
                            {l.label}
                          </a>
                        ))}
                      </p>
                    )}
                  </div>
                </li>
              );
            })}
        </ol>
      </section>
    ))
  )
}
