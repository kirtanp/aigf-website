---
import { Image, getImage } from 'astro:assets';
import { getEntries, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SpeakerCard from '../../components/SpeakerCard.astro';
import { getSpeakers, getAppearances, getEditions, initials, type Speaker } from '../../lib/data';

export async function getStaticPaths() {
  const speakers = await getSpeakers();
  return speakers.map((speaker) => ({ params: { slug: speaker.id }, props: { speaker } }));
}

const { speaker } = Astro.props as { speaker: Speaker };
const { name, title, organisation, photo, links } = speaker.data;
const { Content } = await render(speaker);
const appearances = (await getAppearances()).get(speaker.id) ?? [];
const years = appearances.map((a) => a.year);
const description = [title, organisation].filter(Boolean).join(', ') || `Speaker at the AI Governance Forum`;
const hasBio = Boolean(speaker.body?.trim());
const ogImage = photo ? (await getImage({ src: photo, width: 800, format: 'jpg' })).src : undefined;

// Others from the same (latest) edition, so a visitor can keep browsing.
const latest = appearances[0]?.year;
const latestEdition = (await getEditions()).find((e) => e.data.year === latest);
const peers = latestEdition
  ? (await getEntries(latestEdition.data.speakers.filter((a) => a.speaker.id !== speaker.id).map((a) => a.speaker))).filter((p) => p && !p.data.draft).slice(0, 4)
  : [];
---

<Base title={name} description={`${name}: ${description}.`} image={ogImage} imageAlt={photo ? `Portrait of ${name}` : undefined}>
  <article class="container-site pt-12 pb-20 sm:pt-20 sm:pb-28">
    <p class="mb-10 text-sm font-medium">
      <a href="/speakers" class="group inline-flex items-center gap-1.5 text-muted transition hover:text-brand-blue">
        <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4 transition group-hover:-translate-x-0.5" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M13 8H3M7 4L3 8l4 4" /></svg>
        All speakers
      </a>
    </p>
    <div class="grid gap-10 md:grid-cols-12 md:gap-12 lg:gap-16">
      <div class="fade-in md:col-span-5 lg:col-span-4">
        <div class="aspect-[4/5] max-w-[15rem] overflow-hidden rounded-2xl bg-wash ring-1 ring-white/5 sm:max-w-xs md:max-w-none">
          {
            photo ? (
              <Image src={photo} alt={`Portrait of ${name}`} widths={[384, 576, 768]} sizes="(min-width: 1024px) 384px, (min-width: 768px) 40vw, 384px" loading="eager" class="h-full w-full object-cover object-[50%_25%]" />
            ) : (
              <div class="flex h-full w-full items-center justify-center bg-initials" aria-hidden="true">
                <span class="text-brand-gradient text-7xl font-semibold tracking-tight">{initials(name)}</span>
              </div>
            )
          }
        </div>
        {
          links.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-2">
              {links.map((l) => (
                <li>
                  <a href={l.url} class="inline-flex h-9 items-center gap-1.5 rounded-full border border-line px-4 text-sm font-medium transition hover:border-brand-blue hover:text-brand-blue">
                    {l.label}
                    <svg aria-hidden="true" viewBox="0 0 16 16" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M5 11l6-6M6 5h5v5" /></svg>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="fade-in md:col-span-7 lg:col-span-8">
        {years.length > 0 && <p class="eyebrow text-brand-blue tabular-nums">Speaker · {years.slice().sort().join(', ')}</p>}
        <h1 class="mt-4 text-[clamp(2.25rem,1.6rem+2.6vw,4rem)] leading-[1.02] font-semibold tracking-[-0.03em] text-balance break-words">{name}</h1>
        {title && <p class="text-lead mt-5 text-muted">{title}</p>}
        {organisation && <p class="text-lead mt-1 font-medium">{organisation}</p>}

        {hasBio && <div class="prose-content mt-10 border-t border-line pt-10"><Content /></div>}

        {
          appearances.length > 0 && (
            <section class="mt-14" aria-labelledby="appearances-title">
              <h2 id="appearances-title" class="eyebrow text-muted">At the AI Governance Forum</h2>
              <ul class="mt-4 border-t border-line">
                {appearances.map(({ year, appearance: a }) => (
                  <li class="border-b border-line">
                    <a href={`/editions/${year}`} class="group grid gap-x-6 gap-y-1 py-4 sm:grid-cols-[5rem_1fr_auto] sm:items-baseline">
                      <span class="text-lg font-semibold tabular-nums transition group-hover:text-brand-blue">{year}</span>
                      <span>
                        {a.talkTitle && <span class="block font-medium">{a.talkTitle}</span>}
                        <span class="block text-sm text-muted">{[a.sessionRole, a.roleAtTheTime, a.organisationAtTheTime].filter(Boolean).join(' · ') || 'Speaker'}</span>
                      </span>
                      <svg aria-hidden="true" viewBox="0 0 16 16" class="hidden size-4 text-brand-blue transition group-hover:translate-x-0.5 sm:block" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </div>
  </article>

  {
    peers.length > 0 && (
      <section class="container-site pb-24" aria-labelledby="peers-title" data-reveal>
        <div class="border-t border-line pt-16">
          <SectionHeading title={`Also at the ${latest} edition`} id="peers-title" href={`/editions/${latest}`} linkLabel={`The ${latest} edition`} />
          <ul class="mt-10 grid grid-cols-2 gap-x-5 gap-y-10 sm:gap-x-6 lg:grid-cols-4 lg:gap-x-8">
            {peers.map((p) => <li><SpeakerCard speaker={p!} /></li>)}
          </ul>
        </div>
      </section>
    )
  }
</Base>
