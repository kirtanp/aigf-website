---
import { getEntries } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EventFacts from '../components/EventFacts.astro';
import RegisterButton from '../components/RegisterButton.astro';
import SpeakerCard from '../components/SpeakerCard.astro';
import Schedule from '../components/Schedule.astro';
import Newsletter from '../components/Newsletter.astro';
import { getCurrent, getSite, getHome, getCurrentEdition, getPastEditions, formatDate, placeLabel, ordinal, eventJsonLd } from '../lib/data';

const current = await getCurrent();
const edition = await getCurrentEdition();
const past = (await getPastEditions()).filter((e) => e.data.schedule.length > 0);
// Speakers show as soon as they are added (each has its own Published toggle);
// the schedule waits for "Programme published" in Site settings.
const appearances = edition?.data.speakers ?? [];
const people = await getEntries(appearances.map((a) => a.speaker));
const speakers = appearances.map((a, i) => ({ a, speaker: people[i] })).filter((x) => x.speaker && !x.speaker.data.draft);
const site = await getSite();
const home = await getHome();
const jsonLd = eventJsonLd(current, site, { url: new URL('/programme', Astro.site).href, image: new URL('/og.png', Astro.site).href, description: current.theme || home.tagline || undefined });
const published = current.programmePublished && edition && edition.data.schedule.length > 0;
---

<Base jsonLd={jsonLd} title={`Programme ${current.year}`} description={`Programme of the ${current.title}, ${formatDate(current.date)}, ${current.venue}.`}>
  <PageHeader eyebrow={`${ordinal(current.number)} edition`} title={`Programme ${current.year}`} lead={[formatDate(current.date), placeLabel(current), current.theme].filter(Boolean).join(' · ')}>
    <div class="mt-10 flex flex-wrap items-center gap-3">
      <RegisterButton />
      {
        current.livestreamUrl && (
          <a href={current.livestreamUrl} class="inline-flex h-12 items-center rounded-full border border-line px-6 font-semibold transition hover:border-brand-blue hover:text-brand-blue">
            Watch online
          </a>
        )
      }
    </div>
    <div class="mt-12"><EventFacts /></div>
  </PageHeader>

  {
    speakers.length > 0 && (
      <section class="container-site pb-20 sm:pb-28" aria-labelledby="speakers-title" data-reveal>
        <SectionHeading title="Speakers" id="speakers-title" />
        <ul class="mt-12 grid grid-cols-2 gap-x-5 gap-y-10 sm:grid-cols-3 sm:gap-x-6 lg:grid-cols-4 lg:gap-x-8">
          {speakers.map(({ a, speaker }) => (
            <li>
              <SpeakerCard speaker={speaker!} title={a.roleAtTheTime ?? speaker!.data.title} organisation={a.organisationAtTheTime ?? speaker!.data.organisation} note={a.talkTitle} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="container-site pb-20 sm:pb-28" aria-labelledby="schedule-title" id="schedule" data-reveal>
    {
      published ? (
        <>
          <SectionHeading title="Schedule" id="schedule-title" />
          <div class="mt-10"><Schedule edition={edition!} /></div>
        </>
      ) : (
        <>
          <div class="rounded-2xl border border-dashed border-line px-6 py-14 text-center sm:py-20">
            <p class="eyebrow text-brand-blue">Schedule</p>
            <h2 id="schedule-title" class="text-title mt-3 font-semibold">Programme coming soon</h2>
            <p class="mx-auto mt-4 max-w-xl text-lg text-muted">
              The {current.year} {speakers.length > 0 ? 'schedule' : 'speakers and schedule'} will be published here in the coming weeks.
            </p>
          </div>
          <div class="mt-8"><Newsletter /></div>
        </>
      )
    }
  </section>

  {
    past.length > 0 && (
      <section class="container-site pb-24" aria-labelledby="past-title" data-reveal>
        <div class="border-t border-line pt-16">
          <SectionHeading title="Past programmes" id="past-title" href="/editions" linkLabel="All editions" />
          <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {past.map((e) => (
              <li>
                <a href={`/editions/${e.data.year}#programme`} class="group flex h-full flex-col rounded-2xl p-6 ring-1 ring-line transition hover:ring-brand-blue/40 hover:shadow-[0_12px_32px_-16px_rgb(60_10_255/0.25)]">
                  <span class="text-2xl font-semibold tracking-tight tabular-nums transition group-hover:text-brand-blue">{e.data.year}</span>
                  <span class="mt-3 leading-snug font-medium text-balance">{e.data.theme ?? e.data.title}</span>
                  <span class="mt-auto pt-4 text-sm text-muted">{formatDate(e.data.date, e.data.endDate)} · {placeLabel(e.data)}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>
